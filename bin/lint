#!/usr/bin/env bash
#
# Parses the published sources with a real PHP 7.4, the only thing that can
# prove the downgrade landed.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=_php74.sh
. "$ROOT/bin/_php74.sh"

REPORT="$ROOT/build/lint.txt"
mkdir -p "$ROOT/build"

php74_sh 'for f in $(find src tests -name "*.php" | sort); do php -l "$f" 2>&1 | grep -v "^No syntax errors" || true; done' \
    > "$REPORT"

if [ -s "$REPORT" ]; then
    cat "$REPORT"
    echo "error: PHP 7.4 syntax errors above" >&2
    exit 1
fi

echo "PHP 7.4 syntax check passed ($(find "$ROOT/src" "$ROOT/tests" -name '*.php' | wc -l | tr -d ' ') files)"
